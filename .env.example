# Copy this file to .env in the relevant module (frontend/.env.local,
# backend/.env) and fill in real values there. NEVER commit real secrets.

# --- General ---
NODE_ENV=development
ENVIRONMENT=development

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Backend (backend/.env) ---
DATABASE_URL=postgresql://user:password@localhost:5432/launchbyte
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000

# --- AI (ai/ services, consumed via backend) ---
AI_PROVIDER_API_KEY=
EMBEDDINGS_MODEL=

# --- Data ---
DATA_SOURCE_RATE_LIMIT_PER_MIN=30
