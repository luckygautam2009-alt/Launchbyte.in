# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Node / Frontend ---
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python / Backend / AI / Data ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Data artifacts (never commit scraped/raw data) ---
data/opportunity-data/raw/*
!data/opportunity-data/raw/.gitkeep
data/opportunity-data/archived/*
!data/opportunity-data/archived/.gitkeep

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Logs ---
*.log
logs/
