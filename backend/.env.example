# Copy to .env and fill in real values. Never commit .env.
# Convention: every new env var the app reads goes here with a placeholder.

# --- App ---
APP_NAME=LaunchByte Backend
ENV=local
DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO

# --- Database (PostgreSQL / Supabase) ---
# For local development:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/launchbyte
# For production (e.g. Supabase), connect via transaction pooler on port 6543:
# DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# --- Auth ---
# Required (32+ chars) whenever ENV is not local/test. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=launchbyte.io
JWT_AUDIENCE=launchbyte-api
QR_SIGNING_KEY=replace-with-a-long-random-string-for-qr

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
TRUST_PROXY_HEADERS=false

# --- Email Service ---
EMAIL_BACKEND=console
BREVO_API_KEY=
EMAIL_FROM=noreply@launchbyte.io
ADMIN_INBOX_EMAIL=launchbyte.in26@gmail.com
# For Gmail SMTP, use an App Password (not your login password) with:
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=true
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@launchbyte.io
SMTP_TLS=true

# --- Storage Service ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- Moderation & Reports ---
OPPORTUNITY_REPORT_FLAG_THRESHOLD=3

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
